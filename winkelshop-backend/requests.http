### Get Categories

GET http://localhost:8080/categories

### Get Products

GET http://localhost:8080/products?category=11111111-1111-1111-1111-111111111112

### Get Cart

GET http://localhost:8080/cart
Authorization: Bearer {{accessToken}}

### Add Item To Cart

POST http://localhost:8080/cart/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "22222222-2222-2222-2222-222222222221",
  "quantity": 1
}

### Add Multiple Items To Cart (Run both requests)

POST http://localhost:8080/cart/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "22222222-2222-2222-2222-222222222222",
  "quantity": 2
}

### Add Another Item To Cart

POST http://localhost:8080/cart/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "22222222-2222-2222-2222-222222222223",
  "quantity": 1
}

### Get Wishlist

GET http://localhost:8080/wishlist
Authorization: Bearer {{accessToken}}

### Add Item To Wishlist

POST http://localhost:8080/wishlist/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "22222222-2222-2222-2222-222222222221"
}

### Remove Item From Wishlist

DELETE http://localhost:8080/wishlist/items/{{wishlistItemId}}
Authorization: Bearer {{accessToken}}

### Checkout

POST http://localhost:8080/checkout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "paymentMethod": "credit-card",
  "shippingAddress": {
    "fullName": "Harry Potter",
    "street": "4 Privet Drive",
    "city": "Little Whinging",
    "postalCode": "CR3 0AA",
    "country": "UK"
  }
}

### Login

POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "harry.potter@hogwarts.test",
  "password": "Expelliarmus123!"
}

> {%
    client.test("Store accessToken", function () {
        client.global.set("accessToken", jsonPath(response.body, "$.data.accessToken",))
    });
%}
